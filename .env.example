# Copy to ".env" for `npm run dev`. On Cloudflare use `wrangler secret put NAME`
# (or a .dev.vars file for `wrangler dev`); on Cloud Run use Secret Manager.
# NEVER commit real values. Nothing personal (e-mails, keys) lives in the code.

APP_NAME=Boochi Chat

# ---- Login (e-mail one-time code) -------------------------------------------
# 32+ random characters:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET=
# Owners who may sign in and use PAID models — comma-separated e-mail addresses
ALLOWED_EMAILS=
# Resend (https://resend.com) API key + a sender on a domain you verified there,
# e.g.  MAIL_FROM=Boochi Chat <login@YOUR-DOMAIN>
RESEND_API_KEY=
MAIL_FROM=
# Local development only: show the code on screen when the host is localhost
OTP_DEV_SHOW=false
SESSION_DAYS=7

# ---- Guests ---------------------------------------------------------------
GUEST_ENABLED=true
GUEST_RPM=8
GUEST_RPD=150

# ---- PAID keys → Private mode (providers whose paid terms exclude training) --
GEMINI_API_KEY_PAID=
OPENAI_API_KEY_PAID=

# ---- FREE keys → guests, and owners with Private off -------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GITHUB_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# ---- Model chains (optional) — "provider:model" in priority order -----------
# Missing keys are skipped automatically. Defaults:
# PAID_MODELS=gemini:gemini-3.5-flash-lite,openai:gpt-5.4-mini,gemini:gemini-flash-latest
# FREE_MODELS=openai:gpt-5.4-mini,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b,cerebras:gpt-oss-120b,openrouter:openai/gpt-oss-120b:free,github:openai/gpt-4.1-mini,nvidia:openai/gpt-oss-120b,mistral:mistral-small-latest,deepseek:deepseek-flash
# Append ";vision" or ";text" to a model to override image-support detection.

# ---- Switch endpoints / add your own provider --------------------------------
# Re-point any built-in provider (proxy, gateway, regional endpoint):
#   OPENAI_BASE_URL=https://my-gateway/v1
#   OPENAI_BASE_URL_PAID=https://my-private-gateway/v1   (paid chain only)
# Add ANY OpenAI-compatible provider just with env — pick an id (a-z, 0-9, _):
#   MYLLM_BASE_URL=https://api.my-llm.com/v1
#   MYLLM_API_KEY=...          (free chain)
#   MYLLM_API_KEY_PAID=...     (paid chain)
#   MYLLM_LABEL=My LLM         (optional display name)
#   MYLLM_KIND=openai          (or gemini for a Gemini-format endpoint)
#   FREE_MODELS=myllm:my-model,openai:gpt-5.4-mini
# Works for Ollama / LM Studio / vLLM / LiteLLM / Azure-style gateways too.

# ---- Limits -----------------------------------------------------------------
# No output-token cap is ever sent. This only bounds automatic "continue" calls
# when a provider hits its own hard ceiling.
AUTO_CONTINUE_MAX=8
MAX_REQUEST_MB=30
