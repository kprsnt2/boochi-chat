// Cloudflare Workers deployment (recommended host).
//   npm run cf:deploy
// Secrets (never put keys in this file):
//   npx wrangler secret put AUTH_SECRET
//   npx wrangler secret put ALLOWED_EMAILS
//   npx wrangler secret put RESEND_API_KEY
//   npx wrangler secret put MAIL_FROM          (e.g. "Boochi Chat <login@YOUR-DOMAIN>")
//   npx wrangler secret put GEMINI_API_KEY_PAID   (and any other *_API_KEY / *_API_KEY_PAID)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boochi-chat",
  "main": "server/worker.ts",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // No-log policy: Workers Logs / traces off, no Logpush, no Tail consumers.
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "workers_dev": true,
  "preview_urls": false,
  // Optional global guest limit (uncomment). Works across all isolates.
  // "ratelimits": [
  //   { "name": "GUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  // ],
  "vars": {
    "APP_NAME": "Boochi Chat",
    "GUEST_ENABLED": "true",
    "SESSION_DAYS": "7",
    "AUTO_CONTINUE_MAX": "8",
    "MAX_REQUEST_MB": "30"
    // PAID_MODELS / FREE_MODELS can be set here to change the model chains.
  }
}
